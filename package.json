{
  "name": "sea-level",
  "description": "An interactive offshore booster-recovery simulator built with Three.js, TypeScript, and Vite.",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joewolly/rocket-simulation.git"
  },
  "bugs": {
    "url": "https://github.com/joewolly/rocket-simulation/issues"
  },
  "homepage": "https://github.com/joewolly/rocket-simulation#readme",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "verify": "npm test && npm run test:e2e && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "@types/three": "^0.178.1",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
